FROM alpine:3.24 AS certs
RUN apk add --no-cache ca-certificates
# Defaults live in the config file (not ENV) so a mounted sss.conf can change them; env vars still override.
RUN mkdir /config && printf 'LISTEN_ADDR=0.0.0.0:8080\nDATABASE_URL=/config/sss.db\nRUN_MIGRATIONS=1\n' > /config/sss.conf

FROM scratch
ARG TARGETPLATFORM
COPY --from=certs /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY $TARGETPLATFORM/sss /sss
COPY --from=certs --chown=65534:65534 /config /config
EXPOSE 8080
VOLUME /config
USER 65534
HEALTHCHECK CMD ["/sss","-c","/config/sss.conf","-healthcheck","auto"]
ENTRYPOINT ["/sss","-c","/config/sss.conf"]
