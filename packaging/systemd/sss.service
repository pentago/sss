# Changing the systemd config can be done like this:
# 1) Edit the config file: systemctl edit --full sss
# 2) Restart the process: systemctl restart sss
# All your changes can be reverted with `systemctl revert sss.service`.
# See https://wiki.archlinux.org/index.php/Systemd#Editing_provided_units.
# Also see https://www.freedesktop.org/software/systemd/man/systemd.service.html
# for available configuration options in this file.

[Unit]
Description=sss feed reader
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/sss

# Run as a transient system user. A system service has no home directory, so
# point XDG_DATA_HOME at /var/lib (%S); the database lands in /var/lib/sss/sss.db.
DynamicUser=yes
StateDirectory=sss
Environment=XDG_DATA_HOME=%S

# Load environment variables from /etc/sss.conf (overrides the above).
EnvironmentFile=/etc/sss.conf

# sss uses sd-notify protocol to notify about its readiness.
Type=notify

# Enable watchdog.
WatchdogSec=60s
WatchdogSignal=SIGKILL

# Automatically restart sss if it crashes.
Restart=always
RestartSec=5

# Allocate a directory at /run/sss for Unix sockets.
RuntimeDirectory=sss

# Allow sss to bind to privileged ports (e.g. 80/443 with CERT_DOMAIN) and
# grant nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Ensure the service can never gain new privileges, and deny creating
# SUID/SGID files.
NoNewPrivileges=yes
RestrictSUIDSGID=yes

# Make the system tree read-only; only the StateDirectory/RuntimeDirectory
# above are writable. Note that CERT_FILE/KEY_FILE cannot live under /home.
ProtectSystem=strict
ProtectHome=yes

# Allocate a separate /tmp.
PrivateTmp=yes

# New files are private to the service user.
UMask=0077

# Make device nodes except for /dev/null, /dev/zero, /dev/full,
# /dev/random and /dev/urandom inaccessible.
PrivateDevices=yes

# Hide other processes and non-process parts of /proc.
ProtectProc=invisible
ProcSubset=pid

# Make cgroup file system hierarchy inaccessible.
ProtectControlGroups=yes

# Deny kernel module loading.
ProtectKernelModules=yes

# Make kernel variables (e.g. /proc/sys) read-only.
ProtectKernelTunables=yes

# Deny access to the kernel log ring buffer.
ProtectKernelLogs=yes

# Deny hostname changing.
ProtectHostname=yes

# Deny setting the hardware or system clock.
ProtectClock=yes

# Prohibit access to any kind of namespacing.
RestrictNamespaces=yes

# Deny realtime scheduling.
RestrictRealtime=yes

# Only IPv4/IPv6 (HTTP server, feed fetching, DNS) and Unix sockets
# (sd_notify, LISTEN_ADDR socket paths).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Allow only the system calls a typical service needs; refuse others with
# EPERM instead of killing the process.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

# Deny kernel execution domain changing.
LockPersonality=yes

# Deny memory mappings that are writable and executable.
MemoryDenyWriteExecute=yes

# Not used on purpose:
# - PrivateUsers: capabilities in a private user namespace cannot bind
#   privileged ports in the host network namespace.
# - PrivateNetwork, IPAddressDeny, SocketBindDeny: sss fetches arbitrary
#   feeds and listens on the configured LISTEN_ADDR.

[Install]
WantedBy=multi-user.target
