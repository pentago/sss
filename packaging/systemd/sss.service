# Per-user sss instance: systemctl --user enable --now sss
# Config: ~/.config/sss/sss.conf (example: /usr/share/doc/sss/sss.conf.example)
# Database: ~/.local/share/sss/sss.db
# To keep it running while logged out: loginctl enable-linger $USER

[Unit]
Description=sss feed reader
After=network-online.target

[Service]
ExecStart=/usr/bin/sss
Type=notify
WatchdogSec=60s
WatchdogSignal=SIGKILL
Restart=always
RestartSec=5
NoNewPrivileges=yes
RestrictSUIDSGID=yes
PrivateTmp=yes
UMask=0077
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=default.target
