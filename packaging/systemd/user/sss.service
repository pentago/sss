# Per-user sss instance: systemctl --user enable --now sss
# Config: ~/.config/sss/sss.conf (example: /usr/share/doc/sss/sss.conf.example)
# Database: ~/.local/share/sss/sss.db
# To keep it running while logged out: loginctl enable-linger $USER

[Unit]
Description=sss feed reader (user instance)
After=network-online.target

[Service]
ExecStart=/usr/bin/sss

# sss uses sd-notify protocol to notify about its readiness.
Type=notify

# Enable watchdog.
WatchdogSec=60s
WatchdogSignal=SIGKILL

# Automatically restart sss if it crashes.
Restart=always
RestartSec=5

# User units cannot be fully sandboxed (see the Arch wiki, systemd/Sandboxing),
# and sss needs its XDG config and data directories in $HOME. These settings
# work in the user manager because they rely on NoNewPrivileges + seccomp.
NoNewPrivileges=yes
RestrictSUIDSGID=yes
PrivateTmp=yes
UMask=0077
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=default.target
